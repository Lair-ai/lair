# MicroK8s Cluster Configuration
# Copy this file to cluster.conf and customize for your environment

# Primary node configuration
PRIMARY_NODE_IP=192.168.1.100
CLUSTER_NAME=my-microk8s-cluster

# Join token (generated by primary node)
# Get this by running 'microk8s add-node' on the primary node
JOIN_TOKEN=192.168.1.100:25000/abc123def456ghi789...

# Network configuration
# ACCESS_MODE can be 'lan' or 'public'
ACCESS_MODE=lan

# Remote access (yes/no)
REMOTE_ACCESS=yes

# Node type (primary/secondary)
# This can be overridden by command line parameters
NODE_TYPE=secondary
